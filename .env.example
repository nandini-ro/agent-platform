# Deployment environment. Copy to .env beside docker-compose.yml and fill in.
#
#   cp .env.example .env
#
# This file is for the *deployed* stack. backend/.env stays as it is and is
# used only when you run uvicorn directly for development; it is excluded from
# the image.

# --- Access control -------------------------------------------------------
# Required. Any POST/PUT/PATCH/DELETE under /api must present this as
# X-API-Key, which is what stops a stranger defining an MCP server - and MCP
# servers run commands on this host. The frontend proxy adds it server-side,
# so the browser never sees it and the UI needs no login.
#
# Generate one:  openssl rand -hex 32
AGENT_API_KEY=

# --- LLM providers --------------------------------------------------------
# Required. Provider API keys (Groq, Gemini, OpenAI) are entered per agent in
# the UI and stored encrypted in the database under this master key.
#
# Generate one:  openssl rand -base64 32
#
# Keep it stable and back it up with the data volume: if it is lost or
# changed, every stored provider key must be re-entered.
CREDENTIAL_ENCRYPTION_KEY=

# --- Limits ---------------------------------------------------------------
TOOL_TIMEOUT_SECONDS=10
MCP_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=120
# A nine-tool prompt needs ten: one turn per tool, plus one to write the
# answer. Raise it if agents start running out mid-task.
MAX_TOOL_ITERATIONS=12
MAX_HISTORY_MESSAGES=40

# --- User-defined HTTP tools ----------------------------------------------
# Comma-separated; empty means any public host. Pinning this to the services
# you actually call is the single best limit on what a prompt-injected agent
# can reach.
HTTP_TOOL_ALLOWED_HOSTS=
# Leave false. True lets a UI-defined tool reach this VM's own network and the
# cloud provider's metadata endpoint.
HTTP_TOOL_ALLOW_PRIVATE_NETWORKS=false
HTTP_TOOL_TIMEOUT_SECONDS=10
HTTP_TOOL_MAX_RESPONSE_CHARS=8000
