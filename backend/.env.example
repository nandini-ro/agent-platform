# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
# SQLite for development. For PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/chatbot
DATABASE_URL=sqlite:///./chatbot.db

# --- LLM providers --------------------------------------------------------
# Leave every key blank to run entirely on the built-in deterministic "mock"
# provider. A provider with no key is shown as unavailable in the agent form
# and returns a clear error rather than crashing.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=gpt-5.6-sol

# --- Agent API ------------------------------------------------------------
# Shared secret for POST /api/agents/{id}/chat. Blank leaves the endpoint open
# (fine for localhost). When set, Garak supplies it via $KEY / REST_API_KEY.
AGENT_API_KEY=

# --- Limits ---------------------------------------------------------------
TOOL_TIMEOUT_SECONDS=10
MCP_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=120
MAX_TOOL_ITERATIONS=12
MAX_HISTORY_MESSAGES=40

# --- Outbound HTTP --------------------------------------------------------
# Governs both user-defined HTTP tools and remote (http transport) MCP servers.
# Empty allowlist means any public host. Private, loopback, link-local and
# cloud-metadata addresses are refused unless the second setting is on - turn
# it on only to reach internal services, and prefer pinning hosts instead.
# It is also what the bundled demo_http_server.py on 127.0.0.1 needs.
HTTP_TOOL_ALLOWED_HOSTS=
HTTP_TOOL_ALLOW_PRIVATE_NETWORKS=false

# --- Garak ----------------------------------------------------------------
GARAK_PYTHON=.venv-garak/bin/python
GARAK_REPORT_DIR=garak_runs
SELF_BASE_URL=http://127.0.0.1:8000

# --- CORS -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
